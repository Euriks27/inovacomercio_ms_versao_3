APP_NAME=InovaComercioMS
APP_ENV=development
APP_DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=5000
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-change-me
DATABASE_URL=sqlite:///inovacomercio.db

# Automação local (backend/scripts/automation.py)
AUTOMATION_INTERVAL_SECONDS=300
AUTOMATION_ALERT_COOLDOWN_SECONDS=3600
AUTOMATION_DB_PATH=backend/app/instance/inovacomercio.db

# Rate limiting distribuído (Token Bucket) — no Docker: REDIS_ENABLED=true e REDIS_HOST=redis
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0